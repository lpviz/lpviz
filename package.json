{
  "name": "lpviz",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "test": "bun test",
    "format": "prettier --write apps packages scripts package.json tsconfig.base.json tsconfig.json vite.config.ts index.html && bunx tsc --noEmit && bunx knip",
    "deploy": "npx wrangler deploy --assets=./dist --name lpviz --compatibility-date 2025-09-01",
    "prdeploy": "npx wrangler versions upload --assets=./dist --name lpviz --compatibility-date 2025-09-01",
    "format:check": "prettier --check apps packages scripts package.json tsconfig.base.json tsconfig.json vite.config.ts index.html",
    "golden": "bun scripts/golden.ts",
    "visual": "bun scripts/visual.ts",
    "loc": "sh scripts/loc.sh",
    "check": "bunx tsc --noEmit && bunx knip && bun run lint && bun test && bun run format:check",
    "lint": "oxlint --type-aware --deny-warnings apps packages scripts vite.config.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/three": "^0.181.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "wrangler": "^4.47.0"
  },
  "dependencies": {
    "@lpviz/math": "workspace:*",
    "@lpviz/polytope": "workspace:*",
    "@lpviz/solver-engine": "workspace:*",
    "@lpviz/viewport": "workspace:*",
    "jsoncrush": "^1.1.8",
    "three": "^0.181.1"
  },
  "knip": {
    "includeEntryExports": true,
    "workspaces": {
      ".": {
        "project": [
          "*.ts"
        ],
        "entry": [
          "scripts/*.ts"
        ]
      },
      "apps/web": {
        "project": [
          "src/**/*.ts",
          "docs/*.ts"
        ]
      },
      "packages/math": {
        "project": [
          "src/**/*.ts"
        ]
      },
      "packages/polytope": {
        "project": [
          "src/**/*.ts"
        ]
      },
      "packages/solver-engine": {
        "project": [
          "src/**/*.ts"
        ]
      },
      "packages/viewport": {
        "project": [
          "src/**/*.ts"
        ]
      }
    }
  }
}
